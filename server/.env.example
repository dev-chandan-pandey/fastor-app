NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/fastor
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Configure Twilio Verify (recommended for real SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# In development only, set true to return OTP in API response when Twilio isn't configured.
OTP_DEV_RETURN_CODE=false
